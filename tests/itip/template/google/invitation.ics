BEGIN:VCALENDAR
PRODID:-//Google Inc//Google Calendar 70.9054//EN
VERSION:2.0
CALSCALE:GREGORIAN
METHOD:REQUEST
BEGIN:VTIMEZONE
TZID:Europe/Paris
X-LIC-LOCATION:Europe/Paris
BEGIN:DAYLIGHT
TZOFFSETFROM:+0100
TZOFFSETTO:+0200
TZNAME:GMT+2
DTSTART:19700329T020000
RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=-1SU
END:DAYLIGHT
BEGIN:STANDARD
TZOFFSETFROM:+0200
TZOFFSETTO:+0100
TZNAME:GMT+1
DTSTART:19701025T030000
RRULE:FREQ=YEARLY;BYMONTH=10;BYDAY=-1SU
END:STANDARD
END:VTIMEZONE
BEGIN:VEVENT
DTSTART;TZID={{ iTIP.dtstart.tzinfo }}:{{ iTIP.dtstart.strftime("%Y%m%dT%H%M%S") }}
DTEND;TZID={{ iTIP.dtend.tzinfo }}:{{ iTIP.dtend.strftime("%Y%m%dT%H%M%S") }}
{% if iTIP.rrule == "DAILY" or iTIP.rrule == "YEARLY" %}
RRULE:FREQ={{ iTIP.rrule }}
{% elif iTIP.rrule == "WEEKLY" %}
RRULE:FREQ={{ iTIP.rrule }};BYDAY={{ iTIP.get_rrule_byday() }}
{% elif iTIP.rrule == "MONTHLY" %}
RRULE:FREQ={{ iTIP.rrule }};BYMONTHDAY={{ iTIP.dtstart.day }}
{% endif %}
DTSTAMP:20260505T093026Z
ORGANIZER;CN={{ iTIP.organizer_name }}:mailto:{{ iTIP.organizer_email }}
UID:{{ iTIP.uid }}
{% for attendee in iTIP.attendees %}
ATTENDEE;CUTYPE=INDIVIDUAL;ROLE=REQ-PARTICIPANT;PARTSTAT={{ attendee.partstat }};RSVP=TRUE
 ;CN={{ attendee.name }};X-NUM-GUESTS=0:mailto:{{ attendee.email }}
{% endfor %}
X-MICROSOFT-CDO-OWNERAPPTID:-1924971892
CREATED:20260505T093014Z
DESCRIPTION:{{ iTIP.description }}
LAST-MODIFIED:20260505T093014Z
LOCATION:{{ iTIP.location }}
SEQUENCE:{{ iTIP.sequence }}
STATUS:CONFIRMED
SUMMARY:{{ iTIP.summary }}
TRANSP:OPAQUE
BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:This is an event reminder
TRIGGER:-P0DT0H30M0S
END:VALARM
END:VEVENT
END:VCALENDAR
