BEGIN:VCALENDAR
PRODID:-//K Desktop Environment//NONSGML libkcal 4.3//EN
VERSION:2.0
X-KDE-ICAL-IMPLEMENTATION-VERSION:1.0
METHOD:REQUEST
{% if iTIP.rrule is not none %}
BEGIN:VTIMEZONE
TZID:Europe/Paris
BEGIN:DAYLIGHT
TZNAME:CEST
TZOFFSETFROM:+0000
TZOFFSETTO:+0200
DTSTART:19760328T000000
RDATE:19760328T000000
END:DAYLIGHT
BEGIN:STANDARD
TZNAME:CET
TZOFFSETFROM:+0200
TZOFFSETTO:+0100
DTSTART:19790930T030000
RRULE:FREQ=YEARLY;UNTIL=19961027T030000;BYDAY=-1SU;BYMONTH=9
END:STANDARD
BEGIN:STANDARD
TZNAME:CET
TZOFFSETFROM:+0200
TZOFFSETTO:+0100
DTSTART:19971026T030000
RRULE:FREQ=YEARLY;BYDAY=-1SU;BYMONTH=10
END:STANDARD
BEGIN:STANDARD
TZNAME:CET
TZOFFSETFROM:+0200
TZOFFSETTO:+0100
DTSTART:19760926T010000
RDATE:19760926T010000
RDATE:19770925T030000
RDATE:19781001T030000
RDATE:19950924T030000
END:STANDARD
BEGIN:DAYLIGHT
TZNAME:CEST
TZOFFSETFROM:+0100
TZOFFSETTO:+0200
DTSTART:19810329T020000
RRULE:FREQ=YEARLY;BYDAY=-1SU;BYMONTH=3
END:DAYLIGHT
BEGIN:DAYLIGHT
TZNAME:CEST
TZOFFSETFROM:+0100
TZOFFSETTO:+0200
DTSTART:19770403T020000
RDATE:19770403T020000
RDATE:19780402T020000
RDATE:19790401T020000
RDATE:19800406T020000
END:DAYLIGHT
END:VTIMEZONE
{% endif %}
BEGIN:VEVENT
ORGANIZER;CN={{ iTIP.organizer_name }}:MAILTO:{{ iTIP.organizer_email }}
DTSTAMP:20260506T093238Z
{% for attendee in iTIP.attendees %}
ATTENDEE;CN={{ attendee.name }};RSVP=FALSE;PARTSTAT={{ attendee.partstat }};
 ROLE=REQ-PARTICIPANT;CUTYPE=INDIVIDUAL;X-UID=938706688:mailto:
 {{ attendee.email }}
{% endfor %}
CREATED:20260506T093201Z
UID:{{ iTIP.uid }}
{% if iTIP.sequence is not none %}
SEQUENCE:{{ iTIP.sequence }}
{% endif %}
LAST-MODIFIED:20260506T093201Z
DESCRIPTION:{{ iTIP.description }}
SUMMARY:{{ iTIP.summary }}
LOCATION:{{ iTIP.location }}
{% if iTIP.recurrence_id is not none%}
RECURRENCE-ID;TZID={{ iTIP.recurrence_id.tzinfo }}:{{ iTIP.recurrence_id.strftime("%Y%m%dT%H%M%S") }}
{% endif %}
{% set rrule_until = ';UNTIL=' + iTIP.rrule_until.strftime("%Y%m%dT%H%M%SZ") if iTIP.rrule_until else '' %}
{% if iTIP.rrule == 'DAILY' %}
RRULE:FREQ={{ iTIP.rrule }}{{ rrule_until }}
{% elif iTIP.rrule == 'WEEKLY' %}
RRULE:FREQ={{ iTIP.rrule }}{{ rrule_until }};BYDAY={{ iTIP.get_rrule_byday() }}
{% elif iTIP.rrule == 'MONTHLY' %}
RRULE:FREQ={{ iTIP.rrule }}{{ rrule_until }};BYMONTHDAY={{ iTIP.dtstart.day }}
{% elif iTIP.rrule == "YEARLY" %}
RRULE:FREQ={{ iTIP.rrule }}{{ rrule_until }};INTERVAL=1;BYMONTHDAY={{ iTIP.dtstart.day }};BYMONTH={{ iTIP.dtstart.month }}
{% endif %}
{% for exdate in iTIP.exdate %}
EXDATE:{{ exdate.strftime("%Y%m%dT%H%M%SZ") }}
{% endfor %}
DTSTART:{{ iTIP.dtstart.strftime("%Y%m%dT%H%M%SZ") }}
DTEND:{{ iTIP.dtend.strftime("%Y%m%dT%H%M%SZ") }}
TRANSP:OPAQUE
BEGIN:VALARM
DESCRIPTION:
ACTION:DISPLAY
TRIGGER:-PT15M
X-KDE-KCALCORE-ENABLED:TRUE
END:VALARM
END:VEVENT
END:VCALENDAR
