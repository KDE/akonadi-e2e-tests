BEGIN:VCALENDAR
METHOD:REQUEST
PRODID:Microsoft Exchange Server 2010
VERSION:2.0
BEGIN:VTIMEZONE
TZID:Romance Standard Time
BEGIN:STANDARD
DTSTART:16010101T030000
TZOFFSETFROM:+0200
TZOFFSETTO:+0100
RRULE:FREQ=YEARLY;INTERVAL=1;BYDAY=-1SU;BYMONTH=10
END:STANDARD
BEGIN:DAYLIGHT
DTSTART:16010101T020000
TZOFFSETFROM:+0100
TZOFFSETTO:+0200
RRULE:FREQ=YEARLY;INTERVAL=1;BYDAY=-1SU;BYMONTH=3
END:DAYLIGHT
END:VTIMEZONE
BEGIN:VEVENT
ORGANIZER;CN={{ iTIP.organizer_name }}:mailto:{{ iTIP.organizer_email }}
{% for attendee in iTIP.attendees %}
ATTENDEE;ROLE=REQ-PARTICIPANT;PARTSTAT={{ attendee.partstat }};RSVP=TRUE;CN={{ attendee.name }}:
 mailto:{{ attendee.email }}
{% endfor %}
DESCRIPTION;LANGUAGE=en-US:{{ iTIP.description }}
UID:{{ iTIP.uid }}
SUMMARY;LANGUAGE=en-US:{{ iTIP.summary }}
DTSTART;TZID={{ iTIP.dtstart.tzinfo }}:{{ iTIP.dtstart.strftime("%Y%m%dT%H%M%S") }}
DTEND;TZID={{ iTIP.dtend.tzinfo }}:{{ iTIP.dtend.strftime("%Y%m%dT%H%M%S") }}
CLASS:PUBLIC
PRIORITY:5
DTSTAMP:20260505T150246Z
TRANSP:OPAQUE
STATUS:CONFIRMED
SEQUENCE:{{ iTIP.sequence }}
LOCATION;LANGUAGE=en-US:{{ iTIP.location }}
X-MICROSOFT-CDO-APPT-SEQUENCE:{{ iTIP.sequence }}
X-MICROSOFT-CDO-OWNERAPPTID:2124754749
